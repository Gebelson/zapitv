{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "crons": [
    {
      "path": "/api/featured/cron",
      "schedule": "0 9 * * 1"
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/((?!api/|.*\\..*).*)", "destination": "/index.html" }
  ]
}
