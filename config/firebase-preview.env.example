# Scope ONLY Preview / fix/p0-provider-transitions-20261105.
# VERCEL_ENV is supplied by Vercel. Do not override it with production.
# Public Firebase Web App config from a SEPARATE staging project. No Admin SDK keys.
ZAPITV_PREVIEW_FIREBASE_PROJECT_ID=
ZAPITV_PREVIEW_FIREBASE_API_KEY=
ZAPITV_PREVIEW_FIREBASE_APP_ID=
ZAPITV_PREVIEW_FIREBASE_AUTH_DOMAIN=
ZAPITV_PREVIEW_FIREBASE_DATABASE_ID=
ZAPITV_PREVIEW_FIREBASE_STORAGE_BUCKET=
ZAPITV_PREVIEW_FIREBASE_MESSAGING_SENDER_ID=
# Optional server Firebase-admin token verification: must match the staging project.
FIREBASE_PROJECT_ID=
ADMIN_FIREBASE_UIDS=
# Server-only, staging Turso and administrators. Never copy Production values.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
ADMIN_USER_IDS=
ALLOW_LOCAL_DB=false
APP_URL=
# For LOCAL simulation ONLY: ZAPITV_DEPLOYMENT_ENV=preview
