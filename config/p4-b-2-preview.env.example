# TEMPLATE ONLY. Populate server-side in an untracked private file / Preview scope.
# Never use VITE_ prefixes. Never copy production tokens into Preview.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Exact authorized Preview origin; leave empty only to use injected VERCEL_URL.
APP_URL=

# Read-only preflight inputs, not application runtime configuration.
TURSO_STAGING_DATABASE_URL=
TURSO_STAGING_AUTH_TOKEN=
TURSO_PRODUCTION_DATABASE_URL=
# Set only AFTER dashboard database identities and production bindings were checked.
# Different URL hostnames alone are NOT isolation proof.
P4B2_ISOLATION_REVIEWED=false
