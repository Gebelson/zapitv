{
  "name": "zapitv",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local --import tsx server.ts",
    "build": "npm run test:stability && npm run build:api && vite build",
    "build:api": "esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=api/index.mjs",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local ./node_modules/drizzle-kit/bin.cjs migrate",
    "db:backup": "node --env-file-if-exists=.env.local --import tsx scripts/backup_database.ts",
    "test:database": "tsx tests/database_settings.test.ts",
    "test:auth": "tsx tests/firebase_auth.test.ts",
    "test:watchparty-state": "tsx tests/watchparty_room_state_contract.test.ts",
    "test:watchparty-smoke": "tsx tests/watchparty_modal_smoke.test.ts",
    "test:watchparty-two-browsers": "tsx tests/watchparty_two_browsers.test.ts",
    "test:watchparty-intro": "tsx tests/watchparty_intro_state.test.ts",
    "test:playback-remote-sync": "tsx tests/playback_remote_sync.test.ts",
    "test:stability": "npm run test:watchparty-state && npm run test:watchparty-intro && npm run test:playback-remote-sync",
    "start": "node server.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@tanstack/react-query": "^5.104.3",
    "dexie": "^4.0.1",
    "dexie-react-hooks": "^1.1.7",
    "drizzle-orm": "^0.45.4",
    "express": "^5.2.1",
    "firebase": "^11.3.0",
    "hls.js": "^1.7.3",
    "jose": "^6.2.12",
    "lucide-react": "^0.563.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.4",
    "trystero": "^0.26.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.24.2",
    "playwright": "^1.64.0",
    "tailwindcss": "^4.0.9",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.0"
  }
}
