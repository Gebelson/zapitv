rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: user UID
    // Fields:
    //   - id: string (required)
    //   - name: string (required)
    //   - email: string (required)
    //   - role: string (required, 'user' or 'admin')
    //   - devMode: boolean
    //   - memberSince: string
    //   - plan: string
    //   - status: string
    //   - profiles: list
    //
    // Collection: content
    // Document ID: content ID
    // Fields: id, title, type, rating, year, image, backdrop, description, videoUrl, imdbId, tmdbId, isFeatured, platform, cast, director, genres, ageRating
    //
    // Collection: customSections
    // Document ID: section ID
    // Fields: id, title, items
    //
    // Collection: notifications
    // Document ID: notification ID
    // Fields: id, title, message, type, timestamp, read
    //
    // Collection: keyValueStore
    // Document ID: key
    // Fields: key, value
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.email == "gbrielcerqueira@gmail.com" && request.auth.token.email_verified == true) ||
        (request.auth.token.email == "graficadfuturo@gmail.com") ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['id', 'name', 'email', 'role']) &&
             data.role in ['user', 'admin'] &&
             data.id is string &&
             data.name is string &&
             data.email is string;
    }

    function isSafeUserCreate(data, userId) {
      return isOwner(userId) && data.role == 'user' && data.id == userId;
    }

    function isSafeUserUpdate(data, prevData, userId) {
      return isOwner(userId) && data.role == prevData.role && data.id == prevData.id;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated() && isValidUser(request.resource.data) && (isSafeUserCreate(request.resource.data, userId) || isAdmin());
      allow update: if isAuthenticated() && isValidUser(request.resource.data) && (isSafeUserUpdate(request.resource.data, resource.data, userId) || isAdmin());
      allow delete: if isAdmin();
    }

    match /content/{contentId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /customSections/{sectionId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /keyValueStore/{keyId} {
      allow read: if isAuthenticated();
      // Allow users to write to their own myList and favorites, otherwise require admin
      allow write: if isAdmin() || (isAuthenticated() && (keyId == 'zapitv_mylist_' + request.auth.uid || keyId == 'zapitv_favorites_' + request.auth.uid));
    }
  }
}
